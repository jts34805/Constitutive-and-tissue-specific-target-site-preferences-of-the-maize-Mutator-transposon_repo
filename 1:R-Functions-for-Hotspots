makeFig5PlotInfo <- function(
    HotSpots,
    Mu_SpecificFC=4,
    Gray_MinFE=20,
    Gray_MaxDiff=1.5,
    Expr_Min=.1,
    Expr_EqualFC=2,
    Expr_SpecificFC=10,
    ATAC_TrendTau=c(.25,.75),
    ATAC_SpecificTau=c(.10,.90),
    CircleShape=19
){
  
  eps <- 1e-6
  
  ATAC_Taus <- sort(unique(c(
    ATAC_SpecificTau,
    .50,
    ATAC_TrendTau
  )))
  
  ## Ratios
  MuRatio <- (
    HotSpots$Endosperm_FoldEnrichment + eps
  ) / (
    HotSpots$Leaf_FoldEnrichment + eps
  )
  
  ExprRatio <- (
    HotSpots$Expr_Endosperm + eps
  ) / (
    HotSpots$Expr_Leaf + eps
  )
  
  ATACRatio <- (
    HotSpots$Endosperm_ATAC_Score + eps
  ) / (
    HotSpots$Leaf_ATAC_Score + eps
  )
  
  ## Build PlotInfo
  PlotInfo <- data.frame(
    
    id=rownames(HotSpots),
    
    ## Mu
    Significant=
      !is.na(HotSpots$FDRts) &
      HotSpots$FDRts <= .01,
    
    MuEndo=HotSpots$Endosperm_FoldEnrichment,
    MuLeaf=HotSpots$Leaf_FoldEnrichment,
    MuRatio=MuRatio,
    MuLog2Ratio=log2(MuRatio),
    
    MaxMuFE=pmax(
      HotSpots$Endosperm_FoldEnrichment,
      HotSpots$Leaf_FoldEnrichment,
      na.rm=TRUE
    ),
    
    FoldDiff=
      pmax(
        HotSpots$Endosperm_FoldEnrichment,
        HotSpots$Leaf_FoldEnrichment,
        na.rm=TRUE
      ) /
      pmin(
        HotSpots$Endosperm_FoldEnrichment,
        HotSpots$Leaf_FoldEnrichment,
        na.rm=TRUE
      ),
    
    ## Expression
    ExprEndo=HotSpots$Expr_Endosperm,
    ExprLeaf=HotSpots$Expr_Leaf,
    ExprRatio=ExprRatio,
    ExprLog2Ratio=log2(ExprRatio),
    
    ## ATAC
    ATACEndo=HotSpots$Endosperm_ATAC_Score,
    ATACLeaf=HotSpots$Leaf_ATAC_Score,
    ATACRatio=ATACRatio,
    ATACLog2Ratio=log2(ATACRatio),
    
    ## Annotation
    TSS_distance=HotSpots$TSS_distance,
    TSS_count=HotSpots$TSS_count,
    Gene_assignment=HotSpots$Gene_assignment,
    
    stringsAsFactors=FALSE
  )
  
  rownames(PlotInfo) <- PlotInfo$id
  
  
  ## Plot eligibility
  PlotInfo$Plot <-
    PlotInfo$Gene_assignment == "genic" &
    !is.na(HotSpots$TSS_distance) &
    PlotInfo$TSS_distance <= 500 &
    !is.na(PlotInfo$ExprEndo) &
    !is.na(PlotInfo$ATACEndo)
  
  PlotInfo$pch <- CircleShape
  
  
  ## ATAC quantile regression
  library(quantreg)
  
  Keep <- PlotInfo$Plot & PlotInfo$pch != 1
  
  ATAC_All <- data.frame(
    logLeaf=log10(PlotInfo$ATACLeaf[Keep]+1),
    logEndo=log10(PlotInfo$ATACEndo[Keep]+1)
  )
  
  ATAC_All$M <- (
    ATAC_All$logLeaf +
      ATAC_All$logEndo
  ) / 2
  
  ATAC_All$D <-
    ATAC_All$logEndo -
    ATAC_All$logLeaf
  
  ATAC_Fit <- rq(
    D ~ M,
    tau=ATAC_Taus,
    data=ATAC_All
  )
  
  
  ## Expression classification
  MissingExpr <-
    is.na(PlotInfo$ExprEndo) |
    is.na(PlotInfo$ExprLeaf)
  
  LowExpr <-
    !MissingExpr &
    PlotInfo$ExprLeaf +
    PlotInfo$ExprEndo < Expr_Min
  
  PlotInfo$ExprState <- NA_character_
  
  PlotInfo$ExprState[LowExpr] <- "Low"
  
  PlotInfo$ExprState[
    !MissingExpr & !LowExpr
  ] <- "Equal"
  
  PlotInfo$ExprState[
    !MissingExpr &
      !LowExpr &
      PlotInfo$ExprEndo >
      Expr_EqualFC * PlotInfo$ExprLeaf
  ] <- "TrendEndosperm"
  
  PlotInfo$ExprState[
    !MissingExpr &
      !LowExpr &
      PlotInfo$ExprEndo >
      Expr_SpecificFC * PlotInfo$ExprLeaf
  ] <- "Endosperm"
  
  PlotInfo$ExprState[
    !MissingExpr &
      !LowExpr &
      PlotInfo$ExprLeaf >
      Expr_EqualFC * PlotInfo$ExprEndo
  ] <- "TrendLeaf"
  
  PlotInfo$ExprState[
    !MissingExpr &
      !LowExpr &
      PlotInfo$ExprLeaf >
      Expr_SpecificFC * PlotInfo$ExprEndo
  ] <- "Leaf"
  
  
  ## Mu classification
  PlotInfo$MuClass <- NA_character_
  
  Consistent <-
    PlotInfo$MaxMuFE >= Gray_MinFE &
    PlotInfo$FoldDiff <= Gray_MaxDiff
  
  PlotInfo$MuClass[Consistent] <- "Consistent"
  
  PlotInfo$MuClass[
    PlotInfo$Significant &
      PlotInfo$MuRatio >= Mu_SpecificFC
  ] <- "Endosperm"
  
  PlotInfo$MuClass[
    PlotInfo$Significant &
      PlotInfo$MuRatio <= 1/Mu_SpecificFC
  ] <- "Leaf"
  
  PlotInfo$MuState <- PlotInfo$MuClass
  
  
  ## Predict ATAC quantiles
  Pred <- predict(
    ATAC_Fit,
    newdata=data.frame(M=ATAC_All$M)
  )
  
  colnames(Pred) <- paste0(
    "tau",
    gsub(
      "\\.",
      "",
      sprintf("%.2f",ATAC_Taus)
    )
  )
  
  Pred <- as.data.frame(Pred)
  
  LowerSpecific <- Pred[[
    paste0(
      "tau",
      gsub("\\.","",sprintf("%.2f",ATAC_SpecificTau[1]))
    )
  ]]
  
  LowerTrend <- Pred[[
    paste0(
      "tau",
      gsub("\\.","",sprintf("%.2f",ATAC_TrendTau[1]))
    )
  ]]
  
  UpperTrend <- Pred[[
    paste0(
      "tau",
      gsub("\\.","",sprintf("%.2f",ATAC_TrendTau[2]))
    )
  ]]
  
  UpperSpecific <- Pred[[
    paste0(
      "tau",
      gsub("\\.","",sprintf("%.2f",ATAC_SpecificTau[2]))
    )
  ]]
  
  
  ## ATAC classification
  PlotInfo$ATACState <- NA_character_
  
  PlotRows <- which(Keep)
  
  PlotInfo$ATACState[
    PlotRows[
      ATAC_All$D >= LowerTrend &
        ATAC_All$D <= UpperTrend
    ]
  ] <- "Equal"
  
  PlotInfo$ATACState[
    PlotRows[
      ATAC_All$D > UpperTrend &
        ATAC_All$D <= UpperSpecific
    ]
  ] <- "TrendEndosperm"
  
  PlotInfo$ATACState[
    PlotRows[
      ATAC_All$D > UpperSpecific
    ]
  ] <- "Endosperm"
  
  PlotInfo$ATACState[
    PlotRows[
      ATAC_All$D < LowerTrend &
        ATAC_All$D >= LowerSpecific
    ]
  ] <- "TrendLeaf"
  
  PlotInfo$ATACState[
    PlotRows[
      ATAC_All$D < LowerSpecific
    ]
  ] <- "Leaf"
  
  
  ## Factor levels
  ExprLevels <- c(
    "Endosperm",
    "TrendEndosperm",
    "Equal",
    "TrendLeaf",
    "Leaf",
    "Low"
  )
  
  ATACLevels <- c(
    "Endosperm",
    "TrendEndosperm",
    "Equal",
    "TrendLeaf",
    "Leaf"
  )
  
  MuLevels <- c(
    "Endosperm",
    "Consistent",
    "Leaf"
  )
  
  PlotInfo$ExprState <- factor(
    PlotInfo$ExprState,
    levels=ExprLevels
  )
  
  PlotInfo$ATACState <- factor(
    PlotInfo$ATACState,
    levels=ATACLevels
  )
  
  PlotInfo$MuState <- factor(
    PlotInfo$MuState,
    levels=MuLevels
  )
  
  PlotInfo
}


makeFig5Scatter <- function(X, pc=1, mx=NULL, pch=19, ConsistentCol="lightgray",EndoCol="#67536cff",LeafCol="#73b47cec"){
  
  PlotDat <- PlotInfo[PlotInfo$Plot,]
  if(is.null(mx)) mx <- 10^ceiling(log10(max(X,na.rm=TRUE)))
  
  ## Background
  ConsistentIDs <- rownames(PlotDat)[PlotDat$MuClass=="Consistent"]
  
  plot(
    logtransform(X[ConsistentIDs,1],pc),
    logtransform(X[ConsistentIDs,2],pc),
    pch=pch,
    cex=1,
    col=ConsistentCol,
    xlab=colnames(X)[1],
    ylab=colnames(X)[2],
    xaxt="n",
    yaxt="n",
    xlim=logtransform(c(0,mx),pc),
    ylim=logtransform(c(0,mx),pc)
  )
  
  ## Axes
  mx.exp <- ceiling(log10(mx))
  major.breaks <- c(0,10^(0:mx.exp))
  
  axis(1,at=logtransform(major.breaks,pc),labels=major.breaks,lwd=2)
  axis(2,at=logtransform(major.breaks,pc),labels=major.breaks,lwd=2)
  
  if(mx.exp>=1){
    minor.breaks <- unlist(lapply(0:(mx.exp-1),function(i)(2:9)*10^i))
    minor.breaks <- minor.breaks[minor.breaks<mx]
    
    axis(1,at=logtransform(minor.breaks,pc),labels=FALSE)
    axis(2,at=logtransform(minor.breaks,pc),labels=FALSE)
  }
  
  ## Points
  pts <- PlotDat[!is.na(PlotDat$MuState),]
  pts$x <- X[pts$id,1]
  pts$y <- X[pts$id,2]
  
  pts$col <- c(
    Consistent=ConsistentCol,
    Endosperm=EndoCol,
    Leaf=LeafCol
  )[pts$MuClass]
  
  pts$cex <- ifelse(pts$MuClass=="Consistent",1,1.7)
  
  gray <- pts[pts$MuClass=="Consistent",]
  sig <- pts[pts$MuClass!="Consistent",]
  
  set.seed(2)
  if(nrow(sig)>1) sig <- sig[sample(nrow(sig)),]
  
  points(
    logtransform(gray$x,pc),
    logtransform(gray$y,pc),
    pch=gray$pch,
    col=gray$col,
    cex=gray$cex
  )
  
  points(
    logtransform(sig$x,pc),
    logtransform(sig$y,pc),
    pch=sig$pch,
    col=sig$col,
    cex=sig$cex
  )
  
  ## Legend
  legend(
    "top",
    legend=c(
      "Consistent",
      "Endosperm-enriched",
      "Leaf-enriched"
    ),
    col=c(
      ConsistentCol,
      EndoCol,
      LeafCol
    ),
    pch=pch,
    pt.cex=.5,
    bty="n",
    title="Mu hotspot"
  )
}

DrawExpressionBoundaries <- function(){
  
  theta <- seq(0,pi/2,length.out=500)
  
  lines(
    log10(Expr_Min*cos(theta)+1),
    log10(Expr_Min*sin(theta)+1),
    lwd=.8,
    col=BoundaryCol
  )
  
  DrawBoundary <- function(fc,lty){
    
    x0 <- Expr_Min/sqrt(1+fc^2)
    x <- seq(x0,1000,length.out=1000)
    y <- fc*x
    
    lines(
      log10(x+1),
      log10(y+1),
      lwd=ifelse(lty==1,1.2,.8),
      lty=lty,
      col="gray50"
    )
    
    lines(
      log10(y+1),
      log10(x+1),
      lwd=ifelse(lty==1,1.2,.8),
      lty=lty,
      col=BoundaryCol
    )
  }
  
  DrawBoundary(Expr_EqualFC,2)
  DrawBoundary(Expr_SpecificFC,1)
}

