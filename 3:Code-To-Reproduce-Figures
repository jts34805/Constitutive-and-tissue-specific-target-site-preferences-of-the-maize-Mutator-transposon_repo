############################################################
## MU INSERTION DATA
############################################################

MuGR <- GRanges(
  seqnames = Locs$chr,
  ranges = IRanges(
    start = Locs$position,
    end = Locs$position
  )
)

MuGR <- MuGR[
  as.character(seqnames(MuGR)) %in% main_chr
]


############################################################
## ASSIGN MU INSERTIONS TO GENES
############################################################

cat(
  "Assigning Mu insertions to genes...\n"
)

hits <- findOverlaps(
  MuGR,
  Genes,
  ignore.strand = TRUE
)

Mu_gene <- MuGR[
  queryHits(hits)
]

gene_idx <- subjectHits(hits)


############################################################
## GENE INFORMATION FOR EACH INSERTION
############################################################

gene_start <- start(
  Genes[gene_idx]
)

gene_end <- end(
  Genes[gene_idx]
)

gene_strand <- as.character(
  strand(
    Genes[gene_idx]
  )
)

Mu_pos <- start(
  Mu_gene
)


############################################################
## RELATIVE DISTANCE FROM TSS
############################################################

relative_TSS <- ifelse(
  gene_strand == "+",
  Mu_pos - gene_start,
  gene_end - Mu_pos
)


############################################################
## RELATIVE DISTANCE FROM TTS
############################################################

relative_TTS <- ifelse(
  gene_strand == "+",
  Mu_pos - gene_end,
  gene_start - Mu_pos
)


############################################################
## GENE-BODY POSITION
############################################################

gene_length <- gene_end -
  gene_start

body_fraction <- ifelse(
  gene_strand == "+",
  (Mu_pos - gene_start) /
    gene_length,
  (gene_end - Mu_pos) /
    gene_length
)


############################################################
## MU FOLD ENRICHMENT PROFILE
############################################################

n_flank <- flank / flank_bin

n_bins <- (
  2 * n_flank +
    body_bins
)

## Genome-wide Mu insertion density
Mu_density <- length(MuGR) /
  EffectiveGenomeSize


## Store one FE profile per gene
Mu_profiles <- matrix(
  NA_real_,
  nrow = length(Genes),
  ncol = n_bins
)


############################################################
## CALCULATE FE FOR EACH GENE
############################################################

for(i in seq_along(Genes)) {
  
  s <- as.character(
    strand(Genes[i])
  )
  
  if(s == "*" || is.na(s))
    next
  
  gs <- start(Genes[i])
  ge <- end(Genes[i])
  
  ## Mu insertions assigned to this gene
  mu_i <- Mu_pos[
    gene_idx == i
  ]
  
  
  ##########################################################
  ## UPSTREAM
  ##########################################################
  
  relative_TSS_i <- if(s == "+") {
    mu_i - gs
  } else {
    ge - mu_i
  }
  
  up_idx <- (
    relative_TSS_i >= -flank &
      relative_TSS_i < 0
  )
  
  up_counts <- integer(n_flank)
  
  if(any(up_idx)) {
    
    up_bins <- floor(
      (
        relative_TSS_i[up_idx] +
          flank
      ) / flank_bin
    ) + 1
    
    up_bins <- pmin(
      pmax(
        up_bins,
        1
      ),
      n_flank
    )
    
    up_counts <- tabulate(
      up_bins,
      nbins = n_flank
    )
  }
  
  ## Expected insertions in each 100-bp flank bin
  up_expected <- Mu_density *
    flank_bin
  
  up_FE <- up_counts /
    up_expected
  
  
  ##########################################################
  ## GENE BODY
  ##########################################################
  
  gene_length <- ge - gs
  
  body_fraction <- if(s == "+") {
    (mu_i - gs) /
      gene_length
  } else {
    (ge - mu_i) /
      gene_length
  }
  
  body_idx <- (
    body_fraction >= 0 &
      body_fraction <= 1
  )
  
  body_counts <- integer(body_bins)
  
  if(any(body_idx)) {
    
    body_bins_idx <- pmin(
      floor(
        body_fraction[body_idx] *
          body_bins
      ) + 1,
      body_bins
    )
    
    body_counts <- tabulate(
      body_bins_idx,
      nbins = body_bins
    )
  }
  
  
  ## Genomic intervals represented by each
  ## normalized gene-body bin
  f1 <- (
    0:(body_bins - 1)
  ) / body_bins
  
  f2 <- (
    1:body_bins
  ) / body_bins
  
  
  if(s == "+") {
    
    body_start <- floor(
      gs +
        (ge - gs) * f1
    )
    
    body_end <- floor(
      gs +
        (ge - gs) * f2
    ) - 1
    
  } else {
    
    body_start <- floor(
      ge -
        (ge - gs) * f2
    ) + 1
    
    body_end <- floor(
      ge -
        (ge - gs) * f1
    )
  }
  
  ## Prevent zero-width intervals
  body_end <- pmax(
    body_end,
    body_start
  )
  
  body_width <- (
    body_end -
      body_start +
      1
  )
  
  ## Expected Mu insertions for each body bin
  body_expected <- Mu_density *
    body_width
  
  body_FE <- body_counts /
    body_expected
  
  
  ##########################################################
  ## DOWNSTREAM
  ##########################################################
  
  relative_TTS_i <- if(s == "+") {
    mu_i - ge
  } else {
    gs - mu_i
  }
  
  down_idx <- (
    relative_TTS_i >= 0 &
      relative_TTS_i < flank
  )
  
  down_counts <- integer(n_flank)
  
  if(any(down_idx)) {
    
    down_bins <- floor(
      relative_TTS_i[down_idx] /
        flank_bin
    ) + 1
    
    down_bins <- pmin(
      pmax(
        down_bins,
        1
      ),
      n_flank
    )
    
    down_counts <- tabulate(
      down_bins,
      nbins = n_flank
    )
  }
  
  ## Expected insertions in each downstream bin
  down_expected <- Mu_density *
    flank_bin
  
  down_FE <- down_counts /
    down_expected
  
  
  ##########################################################
  ## COMBINE
  ##########################################################
  
  Mu_profiles[i, ] <- c(
    up_FE,
    body_FE,
    down_FE
  )
}


############################################################
## AVERAGE FE ACROSS GENES
############################################################

Mu_profile <- colMeans(
  Mu_profiles,
  na.rm = TRUE
)

