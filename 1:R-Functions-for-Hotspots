makeBrowser = function(chr, start, end, width = 10000, EffGenomeSize = 2182075994, WindowSize=500, lengthfudge = 0) {
  startat = (round((mean(c(start,end)) - width/2)/500)*500) + lengthfudge
  datasub = which((Locs[,1] == chr) & ((Locs[,2] >= startat) & (Locs[,2] <= (startat + width))))
  dat=MuCounts
  dat1=matrix(data=NA, ncol = 4, nrow=nrow(MuCounts))
  colnames(dat1)=c("Endosperm","Root","Leaf","Pollen")
  Leaf=rowSums(dat[,grepl("L",colnames(dat))])
  Root=rowSums(dat[,grepl("R",colnames(dat))])
  Pollen=rowSums(dat[,grepl("P",colnames(dat))])
  Endosperm=rowSums(dat[,grepl("E",colnames(dat))])
  dat1=cbind(Endosperm, Root, Leaf, Pollen)
  lambda = colSums(dat1 > 0)*WindowSize/EffGenomeSize
  dat1=dat1[datasub,]
  dat1=as.data.frame(dat1)
  position=as.numeric(sub('.+,','',rownames(dat1)))
  dat1$position = position
  mat = apply(dat1[,1:4], 2, function(yy) { sapply(startat:(startat+width), function(xx) { sum(abs(dat1$position[yy > 0] - xx) <= WindowSize/2) }) })
  mat = sweep(mat, 2, lambda, '/')
  
  cols=c('#67536cff','#a05a2cff','#73b47cec','#ffd42aff')
  Tissue=c("Endosperm","Root",'Leaf',"Pollen")
  par(mfrow=c(4,1))
  par(mar=c(1.25, 4.1, 0.5, 2.1))
  for (i in 1:4){
    bp=barplot(mat[,i], border = NA, space = 0, col = cols[i], xaxs = 'i', ylim = c(0,ceiling(max(mat)/50)*50), axisnames = F, main=Tissue[i], axes = F)
    axis(1, at=bp[c(1,nrow(bp)),1],labels =NA, tick = T, lwd = .5)
    axis(2, at=c(0,ceiling(max(mat)/50)*50),tick = T, las = 2, lwd = .5)
  }
  abline(v=bp[start-startat,])
  abline(v=bp[end-startat,])
  axis(1, at=c(bp[1,], bp[nrow(bp),]), labels=c(startat, startat+width), lwd=.5)
}


makeBrowser2 = function(
    HSid,
    tissues = c("Leaf", "Root", "Pollen", "Endosperm"),
    width = 10000,
    EffGenomeSize = 2182075994,
    WindowSize = 500,
    lengthfudge = 0,
    show_heatmap = TRUE
) {
  
  ## Grab hotspot
  hs <- HotSpots[HSid, ]
  
  ## Center browser on hotspot
  center <- mean(c(hs$start, hs$end))
  startat <- round((center - width/2) / 500) * 500 + lengthfudge
  
  ## Mu insertions in browser window
  datasub <- which(
    Locs[,1] == hs$chr &
      Locs[,2] >= startat &
      Locs[,2] <= (startat + width)
  )
  
  dat <- MuCounts
  
  ## Sum insertion counts by tissue
  dat1 <- cbind(
    Leaf      = rowSums(dat[, grepl("L", colnames(dat))]),
    Root      = rowSums(dat[, grepl("R", colnames(dat))]),
    Pollen    = rowSums(dat[, grepl("P", colnames(dat))]),
    Endosperm = rowSums(dat[, grepl("E", colnames(dat))])
  )
  
  ## Keep requested tissues in requested order
  dat1 <- dat1[, tissues, drop = FALSE]
  
  ## Genome-wide expected insertion density
  lambda <- colSums(dat1 > 0) * WindowSize / EffGenomeSize
  
  ## Restrict to browser window
  dat1 <- as.data.frame(dat1[datasub, , drop = FALSE])
  dat1$position <- as.numeric(sub(".+,", "", rownames(dat1)))
  
  ## Rolling window
  mat <- apply(
    dat1[, tissues, drop = FALSE],
    2,
    function(yy) {
      sapply(
        startat:(startat + width),
        function(xx) {
          sum(abs(dat1$position[yy > 0] - xx) <= WindowSize/2)
        }
      )
    }
  )
  
  ## Preserve matrix if only one tissue
  if(length(tissues) == 1)
    mat <- matrix(mat, ncol = 1)
  
  ## Normalize to fold enrichment
  mat <- sweep(mat, 2, lambda, "/")
  
  ## Tissue colors
  tissue.cols <- c(
    Leaf      = "#73b47cec",
    Root      = "#a05a2cff",
    Pollen    = "#ffd42aff",
    Endosperm = "#67536cff"
  )
  
  cols <- tissue.cols[tissues]
  
  ymax <- max(
    50,
    ceiling(max(mat, na.rm = TRUE) / 50) * 50
  )
  
  ## ==========================================================
  ## Layout
  ## ==========================================================
  
  ntracks <- length(tissues)
  
  if(show_heatmap) {
    layout(
      cbind(
        seq_len(ntracks),
        rep(ntracks + 1, ntracks)
      ),
      widths = c(5, 1.2)
    )
  } else {
    layout(
      matrix(seq_len(ntracks), ncol = 1),
      widths = 1
    )
  }
  
  ## ==========================================================
  ## Browser tracks
  ## ==========================================================
  
  par(mar = c(1.25, 4.1, .5, 1))
  
  n <- nrow(mat)
  
  ## Bar centers
  bp <- seq_len(n) - 0.5
  
  ## Hotspot boundaries relative to browser window
  hs_left <- max(0, hs$start - startat)
  hs_right <- min(n, hs$end - startat + 1)
  
  for(i in seq_along(tissues)) {
    
    ## Initialize plotting region
    plot(
      NA,
      xlim = c(0, n),
      ylim = c(0, ymax),
      xaxs = "i",
      yaxs = "i",
      axes = FALSE,
      xlab = "",
      ylab = "",
      main = tissues[i]
    )
    
    ## Gray shading behind called hotspot
    if(hs_left < hs_right) {
      rect(
        xleft = hs_left,
        ybottom = 0,
        xright = hs_right,
        ytop = ymax,
        col = adjustcolor("grey70", alpha.f = 0.35),
        border = NA
      )
    }
    
    ## Insertion density bars
    rect(
      xleft = seq_len(n) - 1,
      ybottom = 0,
      xright = seq_len(n),
      ytop = mat[, i],
      col = cols[i],
      border = NA
    )
    
    ## X-axis ticks
    axis(
      1,
      at = bp[c(1, n)],
      labels = NA,
      tick = TRUE,
      lwd = .5
    )
    
    ## Y-axis ticks
    axis(
      2,
      at = c(0, ymax),
      las = 2,
      tick = TRUE,
      lwd = .5
    )
  }
  
  ## Genomic coordinate labels
  axis(
    1,
    at = bp[c(1, n)],
    labels = c(startat, startat + width),
    lwd = .5
  )
  
  ## ==========================================================
  ## ATAC / RNA heatmap
  ## ==========================================================
  
  if(show_heatmap) {
    
    hm.cols <- colorRampPalette(c(
      "#67536c",
      "white",
      "#73b47c"
    ))(201)
    
    par(mar = c(3, 2, 3, 2))
    
    ## Raw values
    raw.vals <- rbind(
      Endosperm = c(
        hs$Endosperm_ATAC_Score,
        hs$Expr_Endosperm
      ),
      Leaf = c(
        hs$Leaf_ATAC_Score,
        hs$Expr_Leaf
      )
    )
    
    colnames(raw.vals) <- c("ATAC", "RNA")
    
    ## Same statistic as scaleTMP()
    bias <- c(
      diff(raw.vals[, "ATAC"]) / max(raw.vals[, "ATAC"]),
      diff(raw.vals[, "RNA"]) / max(raw.vals[, "RNA"])
    )
    
    zmat <- t(matrix(bias, nrow = 1))
    
    image(
      x = 1:2,
      y = 1,
      z = zmat,
      col = hm.cols,
      zlim = c(-1, 1),
      axes = FALSE,
      xlab = "",
      ylab = ""
    )
    
    box()
    
    axis(
      3,
      at = 1:2,
      labels = c("ATAC", "RNA"),
      tick = FALSE,
      cex.axis = .9
    )
    
    mtext(
      "Bias",
      side = 2,
      line = .5,
      las = 2,
      cex = .9
    )
    
    par(xpd = NA)
    
    for(i in 1:2) {
      text(
        i,
        .60,
        labels = sprintf("%.2f", bias[i]),
        cex = .85,
        font = 2
      )
    }
    
    title(
      main = HSid,
      line = .5,
      cex.main = .9
    )
  }
}
  




