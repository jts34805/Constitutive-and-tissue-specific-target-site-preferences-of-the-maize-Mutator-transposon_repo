####Figure 3 stats and figure making, rewrote here for simplicity and truncation
RunHotspotStats <- function(HScounts, lib.size, min_count = 10, lfc = 1) {
  
  counts <- HScounts[
    rownames(HScounts) != "none",
    !grepl("MI", colnames(HScounts)),
    drop = FALSE
  ]
  
  lib.size <- lib.size[colnames(counts)]
  
  tissue <- factor(
    sub(".*_", "", colnames(counts)),
    levels = c("E", "L", "P", "R")
  )
  
  counts <- counts[
    rowSums(counts) >= min_count,
    ,
    drop = FALSE
  ]
  
  design <- model.matrix(~0 + tissue)
  colnames(design) <- levels(tissue)
  
  y <- estimateDisp(
    DGEList(counts, lib.size = lib.size),
    design,
    robust = TRUE
  )
  
  fit <- glmQLFit(y, design, robust = TRUE)
  
  P <- sapply(
    combn(levels(tissue), 2, simplify = FALSE),
    function(p) {
      glmTreat(
        fit,
        contrast = makeContrasts(
          contrasts = paste0(p[1], "-", p[2]),
          levels = design
        ),
        lfc = lfc
      )$table$PValue
    }
  )
  
  p_comb <- apply(P, 1, function(p) {
    min(sort(p) * length(p) / seq_along(p))
  })
  
  tissue_totals <- tapply(lib.size, tissue, sum)
  
  est <- sweep(
    exp(fit$coefficients),
    2,
    tissue_totals,
    "*"
  )
  
  res <- data.frame(
    hotspot = rownames(counts),
    p_unadjusted = p_comb,
    FDR = p.adjust(p_comb, "BH"),
    setNames(as.data.frame(est), colnames(est))
  )
  
  rownames(res) <- rownames(counts)
  
  res
}
CalculateFE <- function(HScounts, total_insertions, HotSpots, EffectiveGenomeSize) {
  
  hs <- setdiff(rownames(HScounts), "none")
  
  counts <- HScounts[hs, , drop = FALSE]
  
  total_sites <- total_insertions[colnames(counts)]
  
  hs_size <- HotSpots[
    match(hs, rownames(HotSpots)),
    "size"
  ]
  
  FE <- sweep(counts, 2, total_sites, "/")
  
  FE <- sweep(
    FE,
    1,
    hs_size / EffectiveGenomeSize,
    "/"
  )
  
  FE
}
