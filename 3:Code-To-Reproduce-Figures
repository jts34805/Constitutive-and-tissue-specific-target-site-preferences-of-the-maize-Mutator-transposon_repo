##Figure 1 Insertion Sites in a 500 bp window
makeFig1Heatmap = function(
    chr,
    start,
    width = 500,
    binsize = 1,
    maxenr = 500,
    EffGenomeSize = 2182075994
) {
  
  ############################################################
  ## Identify insertion sites in the window
  ############################################################
  
  datasub = which(
    Locs$chr == chr &
      Locs$position >= start &
      Locs$position < (start + width)
  )
  
  
  ############################################################
  ## Samples to plot in heatmap
  ## MI samples intentionally retained as negative controls
  ############################################################
  
  samples = c(2:3, 18:19, 24:25, 42:45)
  
  ############################################################
  ## Mu-active samples for pooled FE calculations
  ## Exclude MI samples
  ############################################################
  
  active_samples = which(!grepl("_MI$", colnames(MuCounts)))
  
  
  ############################################################
  ## Remove inherited insertion sites from heatmap
  ############################################################
  
  datasub = datasub[
    !rownames(MuCounts)[datasub] %in% AllInherited
  ]
  
  ############################################################
  ## Make heatmap data
  ############################################################
  
  bindata = t(apply(
    MuCounts[datasub, samples, drop = FALSE],
    2,
    function(xx) {
      
      bins = ceiling(
        (Locs$position[datasub][xx > 0] - start + 1) / binsize
      )
      
      bincounts = table(bins)[
        as.character(1:ceiling(width / binsize))
      ]
      
      bincounts[is.na(bincounts)] = 0
      
      names(bincounts) = paste(
        chr,
        (1:ceiling(width / binsize) - .5) * binsize + start - 1,
        sep = "_"
      )
      
      bincounts
    }
  ))
  
  
  ############################################################
  ## Individual-sample FE
  ## Used for the values reported in the figure
  ############################################################
  
  n_insertions = colSums(
    MuCounts[datasub, , drop = FALSE] > 0
  )
  
  total_insertions = colSums(
    MuCounts[, , drop = FALSE] > 0
  )
  
  FE = n_insertions / (
    total_insertions * (width / EffGenomeSize)
  )
  
  
  ############################################################
  ## Statistics dataframe
  ############################################################
  
  stats = data.frame(
    Sample = colnames(MuCounts),
    Tissue = sub(
      ".*_",
      "",
      colnames(MuCounts)
    ),
    Insertions = n_insertions,
    TotalInsertions = total_insertions,
    FoldEnrichment = FE,
    row.names = NULL
  )
  
  print(stats)
  
  
  ############################################################
  ## Pooled FE across Mu-active samples
  ## MI samples are excluded
  ############################################################
  
  pooled_insertions = sum(
    n_insertions[active_samples]
  )
  
  pooled_total_insertions = sum(
    total_insertions[active_samples]
  )
  
  pooled_FE = pooled_insertions / (
    pooled_total_insertions *
      (width / EffGenomeSize)
  )
  
  mean_insertions = pooled_insertions / length(active_samples)
  
  
  cat(
    "\nPooled Mu-active FE:",
    pooled_FE,
    "\n"
  )
  
  cat(
    "Total Mu-active insertion observations:",
    pooled_insertions,
    "\n"
  )
  
  cat(
    "Mean insertion sites per Mu-active sample:",
    mean_insertions,
    "\n"
  )
  
  
  ############################################################
  ## Heatmap
  ############################################################
  
  ht = Heatmap(
    bindata,
    col = colorRampPalette(c("grey", "black"))(200),
    name = "Insertion Site",
    column_title = paste(chr, start, sep = " "),
    cluster_columns = F,
    cluster_rows = F,
    show_column_dend = F,
    show_row_dend = F,
    show_column_names = FALSE
  )
  
  draw(ht)
  
  
  ############################################################
  ## Return statistics
  ############################################################
  
  return(stats)
}
