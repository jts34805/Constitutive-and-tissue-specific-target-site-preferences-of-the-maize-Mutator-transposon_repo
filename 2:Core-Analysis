############################################################
## Find transcript landmarks associated with a hotspot
############################################################

findLandmarks <- function(
    hs,
    Landmark = c("TSS","TTS")
){
  
  Landmark <- match.arg(Landmark)
  
  ########################################################
  ## Does hotspot overlap any genes?
  ########################################################
  
  hits <- subjectHits(findOverlaps(hs, GeneGR))
  
  ##------------------------------------------------------
  ## Multiple genes
  ##------------------------------------------------------
  
  if(length(hits) > 1){
    
    return(list(
      
      Assignment = "multi_gene",
      
      Landmarks = NULL
      
    ))
    
  }
  
  ##------------------------------------------------------
  ## Genic hotspot
  ##------------------------------------------------------
  
  if(length(hits) == 1){
    
    gene.id <- GeneGR$Gene[hits]
    
    if(Landmark == "TSS"){
      
      LM <- TSSgr[TSSgr$Gene == gene.id]
      
    }else{
      
      LM <- TTSgr[TTSgr$Gene == gene.id]
      
    }
    
    return(list(
      
      Assignment = "genic",
      
      Landmarks = LM
      
    ))
    
  }
  
  ########################################################
  ## Intergenic hotspot
  ########################################################
  
  if(Landmark == "TSS"){
    
    plus.idx  <- follow(hs, TSSPlus)
    minus.idx <- precede(hs, TSSMinus)
    
    plus.gr  <- if(is.na(plus.idx)) NULL else TSSPlus[plus.idx]
    minus.gr <- if(is.na(minus.idx)) NULL else TSSMinus[minus.idx]
    
  }else{
    
    plus.idx  <- precede(hs, TTSPlus)
    minus.idx <- follow(hs, TTSMinus)
    
    plus.gr  <- if(is.na(plus.idx)) NULL else TTSPlus[plus.idx]
    minus.gr <- if(is.na(minus.idx)) NULL else TTSMinus[minus.idx]
    
  }
  
  ########################################################
  ## Choose nearest landmark
  ########################################################
  
  if(is.null(plus.gr) && is.null(minus.gr)){
    
    LM <- NULL
    
  }else if(is.null(plus.gr)){
    
    LM <- minus.gr
    
  }else if(is.null(minus.gr)){
    
    LM <- plus.gr
    
  }else{
    
    d.plus <- as.numeric(distance(hs, plus.gr))
    d.minus <- as.numeric(distance(hs, minus.gr))
    
    LM <- if(d.plus <= d.minus) plus.gr else minus.gr
    
  }
  
  return(list(
    
    Assignment = "intergenic",
    
    Landmarks = LM
    
  ))
  
}


############################################################
## Calculate signed distances to transcript landmarks
############################################################

landmarkDistances <- function(hs, Landmarks){
  
  if(is.null(Landmarks) || length(Landmarks) == 0)
    return(NULL)
  
  distances <- numeric(length(Landmarks))
  
  for(i in seq_along(Landmarks)){
    
    coord <- start(Landmarks)[i]
    strand <- as.character(strand(Landmarks)[i])
    
    if(strand == "+"){
      
      ## hotspot upstream
      if(end(hs) < coord){
        
        distances[i] <- end(hs) - coord
        
        ## hotspot downstream
      }else if(start(hs) > coord){
        
        distances[i] <- start(hs) - coord
        
        ## overlap
      }else{
        
        distances[i] <- 0
        
      }
      
    }else{
      
      ## Reverse transcriptional space
      
      if(start(hs) > coord){
        
        distances[i] <- coord - start(hs)
        
      }else if(end(hs) < coord){
        
        distances[i] <- coord - end(hs)
        
      }else{
        
        distances[i] <- 0
        
      }
      
    }
    
  }
  
  data.frame(
    
    Gene = Landmarks$Gene,
    
    TranscriptIDs = Landmarks$TranscriptIDs,
    
    Distance = distances,
    
    stringsAsFactors = FALSE
    
  )
  
}

