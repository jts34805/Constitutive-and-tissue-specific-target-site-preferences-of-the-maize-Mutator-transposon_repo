#FDR correct the initial called hotspots
#Nulls was generated using script "HSNulls_Array.R"
score = function(xx) {
  -ppois(xx[1] - 1, xx[2]*(nrow(Locs)/EffectiveGenomeSize), lower.tail=F, log.p=T)
}
HotSpots$Score = apply(HotSpots[,4:5], 1, score)
load("HotSpotNULL_ALL.rda")
all_nulls = lapply(all_nulls, function(X) {
  X$size = abs(apply(X[, 2:3], 1, diff)) + 1
  X
}) #get hotspot sizes for null distributions
all_nulls_scores = unlist(lapply(all_nulls, function(X){X$score=apply(X[,4:5], 1, score)})) #calculate "score" for each null hotspot using hotspot size and insertions detected in the hotspot

# Order by decreasing score first
HotSpots = HotSpots[order(-HotSpots$Score), ]
# Recompute ranks after ordering
FDRs = rank(-c(HotSpots$Score, all_nulls_scores), ties.method = 'max')[1:nrow(HotSpots)]
FDRs2 = rank(-HotSpots$Score, ties.method = 'max')
rawFDR = (FDRs - FDRs2) / FDRs2 / 1000 # Empirical FDR
HotSpots$FDR = cummax(rawFDR)
HotSpots = HotSpots[HotSpots$FDR <= 0.01, ]# Apply cutoff
