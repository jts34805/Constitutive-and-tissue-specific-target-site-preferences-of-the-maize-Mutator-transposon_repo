library(GenomicRanges)
library(rtracklayer)

## Parameters
WindowSize <- 500
EffectiveGenomeSize <- 2182075994

## Counts → presence/absence
MuBinary <- (MuCounts > 0) * 1

## Tissue-level presence/absence
tissues <- c("Endosperm", "Pollen", "Root", "Leaf")
tissue_cols <- lapply(tissues, \(x) grep(paste0("_", substr(x, 1, 1), "$"),
                                         colnames(MuBinary), value = TRUE))

tissue_bin <- lapply(tissue_cols, \(x)
                     as.numeric(rowSums(MuBinary[, x, drop = FALSE]) > 0)
)

names(tissue_bin) <- tissues

## All non-MI samples
All <- colnames(MuBinary)[!grepl("MI", colnames(MuBinary))]
tissue_bin$All <- rowSums(MuBinary[, All, drop = FALSE])

## Parse insertion coordinates
coords <- rownames(MuCounts)
chr <- sub(":.*", "", coords)
pos <- sub(".*:", "", coords)
mid <- round((as.numeric(sub(",.*", "", pos)) +
                as.numeric(sub(".*,", "", pos))) / 2)

## Genome lengths
fai <- read.table("~/Downloads/Zm-B73-REFERENCE-NAM-5.0.fa.gz.fai")
seqlengths <- setNames(fai$V2, fai$V1)

## Remove scaffolds
keep <- chr %in% names(seqlengths)
chr <- chr[keep]
mid <- mid[keep]
tissue_bin <- lapply(tissue_bin, `[`, keep)

## Generate BigWigs
for (tissue in names(tissue_bin)) {
  
  cat("Processing:", tissue, "\n")
  
  gr <- GRanges(
    seqnames = chr,
    ranges = IRanges(
      pmax(1, mid - WindowSize / 2),
      pmin(seqlengths[chr], mid + WindowSize / 2)
    ),
    weight = tissue_bin[[tissue]]
  )
  
  cov <- coverage(gr, weight = gr$weight)
  
  lambda <- sum(tissue_bin[[tissue]] > 0) *
    WindowSize / EffectiveGenomeSize
  
  export(
    cov / lambda,
    paste0(tissue, "_FE_", WindowSize, "bp.bw")
  )
}
