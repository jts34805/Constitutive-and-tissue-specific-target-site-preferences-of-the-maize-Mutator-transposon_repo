############################################################
## FAST ATAC METAGENE FUNCTION
############################################################

get_ATAC_metagene_fast <- function(
    Genes,
    cov,
    flank = 4000,
    flank_bin = 100,
    body_bins = 50
) {
  
  n_flank <- flank / flank_bin
  
  n_total <- (
    2 * n_flank +
      body_bins
  )
  
  sums <- numeric(n_total)
  
  n_genes_total <- 0
  
  
  ##########################################################
  ## PROCESS CHROMOSOMES
  ##########################################################
  
  for(chr in main_chr) {
    
    if(!chr %in% names(cov))
      next
    
    idx <- which(
      as.character(seqnames(Genes)) == chr
    )
    
    if(length(idx) == 0)
      next
    
    g <- Genes[idx]
    
    strand_g <- as.character(
      strand(g)
    )
    
    atac <- cov[[chr]]
    
    ng <- length(g)
    
    gene_start <- start(g)
    gene_end <- end(g)
    
    
    ########################################################
    ## PROCESS PLUS AND MINUS STRANDS
    ########################################################
    
    for(s in c("+", "-")) {
      
      keep <- strand_g == s
      
      if(!any(keep))
        next
      
      gs <- gene_start[keep]
      ge <- gene_end[keep]
      
      ngs <- length(gs)
      
      
      ######################################################
      ## UPSTREAM
      ######################################################
      
      ##
      ## Build all upstream windows at once.
      ##
      
      if(s == "+") {
        
        up_start <- outer(
          gs,
          seq(
            -flank,
            -flank_bin,
            by = flank_bin
          ),
          "+"
        )
        
      } else {
        
        up_start <- outer(
          ge,
          seq(
            -flank,
            -flank_bin,
            by = flank_bin
          ),
          "+"
        )
        
        ## For minus strand, reverse biological direction
        up_start <- ge +
          outer(
            rep(1, ngs),
            seq(
              -flank,
              -flank_bin,
              by = flank_bin
            ),
            "+"
          )
      }
      
      up_end <- up_start +
        flank_bin -
        1
      
      
      ## Convert to vectors
      up_values <- viewMeans(
        Views(
          atac,
          start = as.vector(up_start),
          end = as.vector(up_end)
        )
      )
      
      up_values <- matrix(
        up_values,
        nrow = ngs,
        ncol = n_flank
      )
      
      
      ######################################################
      ## GENE BODY
      ######################################################
      
      ## Fractional positions along each gene
      
      f1 <- (
        0:(body_bins - 1)
      ) / body_bins
      
      f2 <- (
        1:body_bins
      ) / body_bins
      
      
      if(s == "+") {
        
        body_start <- outer(
          gs,
          f1,
          function(x, f)
            floor(
              x +
                (ge - x) * f
            )
        )
        
        body_end <- outer(
          gs,
          f2,
          function(x, f)
            floor(
              x +
                (ge - x) * f
            ) - 1
        )
        
      } else {
        
        ## Biological TSS -> TTS orientation
        
        body_start <- outer(
          ge,
          f2,
          function(x, f)
            floor(
              x -
                (x - gs) * f
            ) + 1
        )
        
        body_end <- outer(
          ge,
          f1,
          function(x, f)
            floor(
              x -
                (x - gs) * f
            )
        )
      }
      
      
      ## Prevent zero-width intervals
      body_end <- pmax(
        body_end,
        body_start
      )
      
      
      body_values <- viewMeans(
        Views(
          atac,
          start = as.vector(body_start),
          end = as.vector(body_end)
        )
      )
      
      body_values <- matrix(
        body_values,
        nrow = ngs,
        ncol = body_bins
      )
      
      
      ######################################################
      ## DOWNSTREAM
      ######################################################
      
      if(s == "+") {
        
        down_start <- outer(
          ge,
          seq(
            1,
            flank - flank_bin + 1,
            by = flank_bin
          ),
          "+"
        )
        
      } else {
        
        down_start <- outer(
          gs,
          seq(
            1,
            flank - flank_bin + 1,
            by = flank_bin
          ),
          "-"
        )
      }
      
      if(s == "+") {
        
        down_start <- down_start
        
      } else {
        
        ## Convert to genomic coordinates
        down_start <- gs -
          outer(
            rep(1, ngs),
            seq(
              flank_bin,
              flank,
              by = flank_bin
            ),
            "+"
          ) +
          1
      }
      
      down_end <- down_start +
        flank_bin -
        1
      
      
      down_values <- viewMeans(
        Views(
          atac,
          start = as.vector(down_start),
          end = as.vector(down_end)
        )
      )
      
      down_values <- matrix(
        down_values,
        nrow = ngs,
        ncol = n_flank
      )
      
      
      ######################################################
      ## REVERSE MINUS-STRAND FLANKS
      ######################################################
      
      if(s == "-") {
        
        up_values <- up_values[
          ,
          n_flank:1,
          drop = FALSE
        ]
        
        down_values <- down_values[
          ,
          n_flank:1,
          drop = FALSE
        ]
      }
      
      
      ######################################################
      ## COMBINE
      ######################################################
      
      profile <- cbind(
        up_values,
        body_values,
        down_values
      )
      
      
      ######################################################
      ## AVERAGE ACROSS GENES
      ######################################################
      
      sums <- sums +
        colSums(
          profile
        )
      
      n_genes_total <-
        n_genes_total +
        ngs
    }
  }
  
  
  ##########################################################
  ## RETURN MEAN PROFILE
  ##########################################################
  
  sums / n_genes_total
}


