TranscriptDistances <- data.frame(
  
  Assignment = rep(NA_character_, length(HotSpotsGR)),
  
  TSS_gene = rep(NA_character_, length(HotSpotsGR)),
  TSS_transcripts = rep(NA_character_, length(HotSpotsGR)),
  TSS_distance = rep(NA_character_, length(HotSpotsGR)),
  
  TTS_gene = rep(NA_character_, length(HotSpotsGR)),
  TTS_transcripts = rep(NA_character_, length(HotSpotsGR)),
  TTS_distance = rep(NA_character_, length(HotSpotsGR)),
  
  row.names = names(HotSpotsGR),
  
  stringsAsFactors = FALSE
  
)

############################################################
## Annotate hotspots
############################################################

for(i in seq_along(HotSpotsGR)){
  
  hs <- HotSpotsGR[i]
  
  ########################################################
  ## TSS annotation
  ########################################################
  
  TSS <- findLandmarks(
    hs,
    Landmark = "TSS"
  )
  
  ########################################################
  ## TTS annotation
  ########################################################
  
  TTS <- findLandmarks(
    hs,
    Landmark = "TTS"
  )
  
  ########################################################
  ## Assignment
  ########################################################
  
  ## Should be identical for TSS and TTS
  stopifnot(TSS$Assignment == TTS$Assignment)
  TranscriptDistances$Assignment[i] <- TSS$Assignment
  
  ########################################################
  ## TSS
  ########################################################
  
  if(!is.null(TSS$Landmarks)){
    
    TSSdist <- landmarkDistances(
      hs,
      TSS$Landmarks
    )
    
    ## Sanity check
    stopifnot(length(unique(TSSdist$Gene)) == 1)
    
    TranscriptDistances$TSS_gene[i] <-
      unique(TSSdist$Gene)
    
    TranscriptDistances$TSS_transcripts[i] <-
      paste(
        TSSdist$TranscriptIDs,
        collapse = ";"
      )
    
    TranscriptDistances$TSS_distance[i] <-
      paste(
        TSSdist$Distance,
        collapse = ","
      )
    
  }
  ########################################################
  ## TTS
  ########################################################
  
  if(!is.null(TTS$Landmarks)){
    
    TTSdist <- landmarkDistances(
      hs,
      TTS$Landmarks
    )
    
    ## Sanity check
    stopifnot(length(unique(TTSdist$Gene)) == 1)
    
    TranscriptDistances$TTS_gene[i] <-
      unique(TTSdist$Gene)
    
    TranscriptDistances$TTS_transcripts[i] <-
      paste(
        TTSdist$TranscriptIDs,
        collapse = ";"
      )
    
    TranscriptDistances$TTS_distance[i] <-
      paste(
        TTSdist$Distance,
        collapse = ","
      )
    
  }
  
  if(i %% 1000 == 0)
    cat(i, "hotspots processed\n")
  
}
rangeDistance <- function(x){
  
  if(is.na(x))
    return(NA_real_)
  
  vals <- as.numeric(strsplit(x, ",", fixed = TRUE)[[1]])
  
  diff(range(vals))
}
TranscriptDistances$TSS_range <- vapply(
  TranscriptDistances$TSS_distance,
  rangeDistance,
  numeric(1)
)


############################################################
## Select most upstream TSS and most downstream TTS
############################################################

selectExtremeDistance <- function(x, direction = c("max", "min")) {
  
  direction <- match.arg(direction)
  
  if(is.na(x))
    return(NA_real_)
  
  vals <- as.numeric(
    strsplit(x, ",", fixed = TRUE)[[1]]
  )
  
  vals <- vals[is.finite(vals)]
  
  if(length(vals) == 0)
    return(NA_real_)
  
  if(direction == "max") {
    max(vals)
  } else {
    min(vals)
  }
}


