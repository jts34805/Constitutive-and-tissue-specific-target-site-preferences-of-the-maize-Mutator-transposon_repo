makeBrowser3 = function(
    HSid,
    width = 10000,
    EffGenomeSize = 2182075994,
    WindowSize = 500,
    methylation = NULL
) {
  
  ## Grab hotspot
  hs <- HotSpots[HSid, ]
  
  ## Center browser on hotspot
  center <- mean(c(hs$start, hs$end))
  startat <- round((center - width/2) / 500) * 500
  endat <- startat + width
  
  
  ############################################################
  ## Mu insertion data
  ############################################################
  
  dat <- MuCounts
  
  dat1 <- cbind(
    Endosperm = rowSums(dat[, grepl("E", colnames(dat))]),
    Leaf      = rowSums(dat[, grepl("L", colnames(dat))])
  )
  
  ## Lambda for Mu fold enrichment
  lambda <- colSums(dat1 > 0) * WindowSize / EffGenomeSize
  
  ## Restrict Mu insertions to browser region
  datasub <- which(
    Locs[,1] == hs$chr &
      Locs[,2] >= startat &
      Locs[,2] <= endat
  )
  
  dat1 <- as.data.frame(dat1[datasub, , drop = FALSE])
  
  dat1$position <- as.numeric(
    sub(".+,", "", rownames(dat1))
  )
  
  
  ## Rolling Mu window
  mat <- apply(
    dat1[, c("Endosperm", "Leaf"), drop = FALSE],
    2,
    function(yy) {
      sapply(
        startat:endat,
        function(xx) {
          sum(abs(dat1$position[yy > 0] - xx) <= WindowSize/2)
        }
      )
    }
  )
  
  if(is.null(dim(mat)))
    mat <- matrix(mat, ncol = 2)
  
  ## Convert to fold enrichment
  mat <- sweep(mat, 2, lambda, "/")
  
  
  ############################################################
  ## ATAC data
  ############################################################
  
  ## Extract ATAC coverage for chromosome
  atacE <- covE[[hs$chr]]
  atacL <- covL[[hs$chr]]
  
  ## Restrict to browser region
  atacE <- window(
    atacE,
    start = startat,
    end = endat
  )
  
  atacL <- window(
    atacL,
    start = startat,
    end = endat
  )
  
  ## Convert Rle to numeric vectors
  atacE <- as.numeric(atacE)
  atacL <- as.numeric(atacL)
  
  
  ############################################################
  ## Methylation data -- OPTIONAL
  ############################################################
  
  if (!is.null(methylation)) {
    
    methsub <- methylation[
      as.character(seqnames(methylation)) == hs$chr &
        start(methylation) >= startat &
        start(methylation) < endat
    ]
    
    ## Convert methylation percentage to colors
    meth.cols <- colorRampPalette(
      c("white", "darkgray", "black")
    )(101)
    
    meth.col <- meth.cols[
      round(methsub$methylation) + 1
    ]
  }
  
  
  ############################################################
  ## Plot settings
  ############################################################
  
  tissue.cols <- c(
    Endosperm = "#67536c",
    Leaf      = "#73b47c"
  )
  
  ## Common y-axis for Mu
  mu.ymax <- ceiling(
    max(mat, na.rm = TRUE) / 50
  ) * 50
  
  ## Common y-axis for ATAC
  atac.ymax <- ceiling(
    max(c(atacE, atacL), na.rm = TRUE) / 5
  ) * 5
  
  
  ############################################################
  ## Layout
  ############################################################
  
  if (is.null(methylation)) {
    
    layout(
      matrix(
        1:4,
        ncol = 1
      ),
      heights = c(1, 1, 1, 1)
    )
    
  } else {
    
    layout(
      matrix(
        1:5,
        ncol = 1
      ),
      heights = c(1, 1, 1, 1, 0.35)
    )
  }
  
  
  ############################################################
  ## Leaf Mu
  ############################################################
  
  par(
    mar = c(0.5, 4.1, 1.2, 1)
  )
  
  bp <- barplot(
    mat[, "Leaf"],
    border = NA,
    space = 0,
    col = tissue.cols["Leaf"],
    xaxs = "i",
    ylim = c(0, mu.ymax),
    axisnames = FALSE,
    main = paste0(
      "Leaf Mu (FPKM = ",
      sprintf("%.2f", hs$Expr_Leaf),
      ")"
    ),
    axes = FALSE
  )
  
  ## Black baseline
  abline(
    h = 0,
    col = "black",
    lwd = 0.8
  )
  
  axis(
    2,
    at = c(0, mu.ymax),
    las = 2,
    tick = TRUE,
    lwd = .5
  )
  
  
  ############################################################
  ## Endosperm Mu
  ############################################################
  
  par(
    mar = c(0.5, 4.1, 1.2, 1)
  )
  
  bp <- barplot(
    mat[, "Endosperm"],
    border = NA,
    space = 0,
    col = tissue.cols["Endosperm"],
    xaxs = "i",
    ylim = c(0, mu.ymax),
    axisnames = FALSE,
    main = paste0(
      "Endosperm Mu (FPKM = ",
      sprintf("%.2f", hs$Expr_Endosperm),
      ")"
    ),
    axes = FALSE
  )
  
  ## Black baseline
  abline(
    h = 0,
    col = "black",
    lwd = 0.8
  )
  
  axis(
    2,
    at = c(0, mu.ymax),
    las = 2,
    tick = TRUE,
    lwd = .5
  )
  
  
  ############################################################
  ## Leaf ATAC
  ############################################################
  
  par(
    mar = c(0.5, 4.1, 1.2, 1)
  )
  
  plot(
    startat:endat,
    atacL,
    type = "l",
    lwd = 1,
    col = tissue.cols["Leaf"],
    xaxs = "i",
    ylim = c(0, atac.ymax),
    axes = FALSE,
    xlab = "",
    ylab = "",
    main = "Leaf ATAC"
  )
  
  polygon(
    c(startat:endat, endat:startat),
    c(atacL, rep(0, length(atacL))),
    col = tissue.cols["Leaf"],
    border = NA
  )
  
  lines(
    startat:endat,
    atacL,
    col = tissue.cols["Leaf"],
    lwd = 1
  )
  
  ## Black baseline
  abline(
    h = 0,
    col = "black",
    lwd = 0.8
  )
  
  axis(
    2,
    at = c(0, atac.ymax),
    las = 2,
    tick = TRUE,
    lwd = .5
  )
  
  
  ############################################################
  ## Endosperm ATAC
  ############################################################
  
  par(
    mar = c(
      if (is.null(methylation)) 3 else 0.5,
      4.1,
      1.2,
      1
    )
  )
  
  plot(
    startat:endat,
    atacE,
    type = "l",
    lwd = 1,
    col = tissue.cols["Endosperm"],
    xaxs = "i",
    ylim = c(0, atac.ymax),
    axes = FALSE,
    xlab = "",
    ylab = "",
    main = "Endosperm ATAC"
  )
  
  polygon(
    c(startat:endat, endat:startat),
    c(atacE, rep(0, length(atacE))),
    col = tissue.cols["Endosperm"],
    border = NA
  )
  
  lines(
    startat:endat,
    atacE,
    col = tissue.cols["Endosperm"],
    lwd = 1
  )
  
  ## Black baseline
  abline(
    h = 0,
    col = "black",
    lwd = 0.8
  )
  
  ## Shared genomic x-axis
  if (is.null(methylation)) {
    
    axis(
      1,
      at = c(startat, endat),
      labels = c(startat, endat),
      lwd = .5
    )
  }
  
  axis(
    2,
    at = c(0, atac.ymax),
    las = 2,
    tick = TRUE,
    lwd = .5
  )
  
  
  ############################################################
  ## DNA methylation -- OPTIONAL
  ############################################################
  
  if (!is.null(methylation)) {
    
    par(
      mar = c(3, 4.1, 1.2, 1)
    )
    
    plot(
      NA,
      xlim = c(startat, endat),
      ylim = c(0, 1),
      xaxs = "i",
      yaxs = "i",
      axes = FALSE,
      xlab = "",
      ylab = "",
      main = "DNA Methylation"
    )
    
    ## Draw 10-bp methylation bins
    rect(
      xleft = start(methsub),
      xright = end(methsub),
      ybottom = 0,
      ytop = 1,
      col = meth.col,
      border = NA
    )
    
    ## Genomic x-axis
    axis(
      1,
      at = c(startat, endat),
      labels = c(startat, endat),
      lwd = .5
    )
    
    ## Methylation axis
    axis(
      2,
      at = c(0, 1),
      labels = c("0", "100"),
      las = 2,
      tick = TRUE,
      lwd = .5
    )
  }
  
  
  ############################################################
  ## Figure title
  ############################################################
  
  title(
    main = HSid,
    line = .5,
    cex.main = .9
  )
}
