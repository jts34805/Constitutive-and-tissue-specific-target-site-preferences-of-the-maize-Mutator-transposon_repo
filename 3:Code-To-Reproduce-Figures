# ============================================================
# 1. Calculate FE in genomic windows
# ============================================================

getFE <- function(d1, d2, w = 500, s = 500) {
  
  getloc <- function(d) {
    x <- do.call(rbind, strsplit(rownames(d), "[:,]"))
    data.frame(
      chr = x[, 1],
      pos = rowMeans(matrix(as.numeric(x[, 2:3]), ncol = 2))
    )
  }
  
  l1 <- getloc(d1)
  l2 <- getloc(d2)
  
  d1 <- d1 > 0
  d2 <- d2 > 0
  
  lam1 <- colSums(d1) * w / EffGenomeSize
  lam2 <- colSums(d2) * w / EffGenomeSize
  
  get <- function(d, l, lam, chr, centers) {
    i <- l$chr == chr
    mat <- matrix(0, length(centers), ncol(d))
    
    for (j in seq_len(ncol(d))) {
      ins <- sort(l$pos[i][d[i, j]])
      
      if (length(ins))
        mat[, j] <-
          findInterval(centers + w / 2, ins, left.open = TRUE) -
          findInterval(centers - w / 2, ins, left.open = TRUE)
    }
    
    sweep(mat, 2, lam, "/")
  }
  
  chrs <- union(unique(l1$chr), unique(l2$chr))
  out1 <- out2 <- list()
  
  for (chr in chrs) {
    p <- c(l1$pos[l1$chr == chr], l2$pos[l2$chr == chr])
    centers <- seq(min(p), max(p), by = s)
    
    out1[[chr]] <- get(d1, l1, lam1, chr, centers)
    out2[[chr]] <- get(d2, l2, lam2, chr, centers)
  }
  
  data.frame(
    setNames(list(
      as.numeric(do.call(rbind, out1)[, 1]),
      as.numeric(do.call(rbind, out2)[, 1])
    ), c(colnames(d1), colnames(d2))),
    check.names = FALSE
  )
}


