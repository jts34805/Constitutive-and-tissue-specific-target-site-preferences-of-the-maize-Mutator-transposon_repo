# ============================================================
# 3. Calculate mean R² by tissue and window size
# ============================================================

pairwiseR2 <- function(MuCounts, samples, WindowSize) {
  
  d <- MuCounts[, samples, drop = FALSE] > 0
  keep <- rowSums(d) > 0 & !rownames(d) %in% AllInherited
  d <- d[keep, , drop = FALSE]
  
  x <- do.call(rbind, strsplit(rownames(d), "[:,]"))
  chr <- x[, 1]
  pos <- rowMeans(matrix(as.numeric(x[, 2:3]), ncol = 2))
  
  nsamp <- ncol(d)
  sums <- numeric(nsamp)
  cross <- matrix(0, nsamp, nsamp)
  nwin <- 0
  
  for (cc in unique(chr)) {
    
    ii <- which(chr == cc)
    p <- pos[ii]
    centers <- seq(min(p), max(p), by = WindowSize)
    
    ins <- lapply(seq_len(nsamp), function(j)
      sort(p[d[ii, j]])
    )
    
    counts <- matrix(0, length(centers), nsamp)
    
    for (j in seq_len(nsamp)) {
      if (length(ins[[j]]))
        counts[, j] <-
          findInterval(centers + WindowSize / 2,
                       ins[[j]], left.open = TRUE) -
          findInterval(centers - WindowSize / 2,
                       ins[[j]], left.open = TRUE)
    }
    
    nwin <- nwin + nrow(counts)
    sums <- sums + colSums(counts)
    cross <- cross + crossprod(counts)
  }
  
  centered <- cross - tcrossprod(sums) / nwin
  r <- centered / sqrt(outer(diag(centered), diag(centered)))
  r2 <- r[upper.tri(r)]^2
  
  mean(r2, na.rm = TRUE)
}


