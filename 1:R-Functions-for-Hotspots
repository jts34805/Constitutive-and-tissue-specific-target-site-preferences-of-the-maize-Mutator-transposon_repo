logtransform = function(xx, pc=1){
  log10(xx + pc) - log10(pc)
}

CategorizeExp2 <- function(
    hs,
    tissuematch = grepl("Endosperm", colnames(Genes_pooled)),
    lowthresh = 0.1,
    specthresh = log10(2)
){
  
  ## Keep only genes present in the expression matrix
  hs2 <- hs[hs$GeneID %in% rownames(Genes_pooled), ]
  
  ## Raw pooled expression
  GeneDat <- Genes_pooled[hs2$GeneID, , drop = FALSE]
  
  ## Poor expression (<0.1 FPKM on average)
  PoorExpr <- rowMeans(GeneDat) < lowthresh
  
  ## Log-transform for downstream calculations
  GeneDat <- logtransform(GeneDat,pc=0.1)
  
  
  ## Convert logical tissue selection to column indices
  if(is.logical(tissuematch))
    tissuematch <- which(tissuematch)
  
  

  
  ## Poor expression (<0.1 FPKM in every tissue)
  
  
  ## Tissue specificity score
  if(length(tissuematch) > 1){
    
    tisScore <-
      apply(GeneDat[, tissuematch], 1, max) -
      apply(GeneDat[, -tissuematch], 1, max)
    
  } else {
    
    tisScore <-
      GeneDat[, tissuematch] -
      apply(GeneDat[, -tissuematch], 1, max)
    
  }
  
  ## Base classification
  Agreement <-
    c("Discordant",
      "MultiTissue_Expression",
      "Concordant_Expression")[
        1 +
          (tisScore >= -specthresh) +
          (tisScore >  specthresh)
      ]
  
  
  ## Poor expression overrides everything
  Agreement[PoorExpr] <- "Poor"
  
  ## Return in the same order as the input hotspots
  out <- data.frame(
    Agreement = Agreement,
    row.names = rownames(hs2)
  )
  
  out <- out[
    match(rownames(hs), rownames(out)),
    ,
    drop = FALSE
  ]
  
  rownames(out) <- rownames(hs)
  
  return(out)
}


